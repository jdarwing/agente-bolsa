<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agentedebolsa.runnerdiario</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/darwingcasana/Library/CloudStorage/OneDrive-AGRICOLADONRICARDO/My Information/Agentes IA/Agente de Bolsa/agente/run_daily.sh</string>
    </array>

    <!-- Lunes a viernes, 6:00 pm hora de Perú (la hora del sistema de la Mac). -->
